{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provider Registry Schema",
  "description": "Schema for validating the provider registry configuration",
  "type": "object",
  "required": ["version", "providers", "capabilityDefinitions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "providers": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "id",
            "name",
            "description",
            "envKey",
            "package",
            "defaultModels",
            "capabilities",
            "endpoints"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "envKey": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "package": {
              "type": "string",
              "pattern": "^@pk-code/[a-z][a-z0-9-]*$"
            },
            "defaultModels": {
              "type": "object",
              "properties": {
                "chat": {
                  "type": "string",
                  "minLength": 1
                },
                "fast": {
                  "type": "string",
                  "minLength": 1
                },
                "embedding": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "legacy": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minProperties": 1
            },
            "capabilities": {
              "type": "object",
              "required": [
                "vision",
                "toolCalling",
                "streaming",
                "embedding",
                "imageGeneration",
                "maxContext",
                "supportsSystemMessages",
                "supportsParallelTools"
              ],
              "properties": {
                "vision": {
                  "type": "boolean"
                },
                "toolCalling": {
                  "type": "boolean"
                },
                "streaming": {
                  "type": "boolean"
                },
                "embedding": {
                  "type": "boolean"
                },
                "imageGeneration": {
                  "type": "boolean"
                },
                "maxContext": {
                  "type": "integer",
                  "minimum": 1
                },
                "supportsSystemMessages": {
                  "type": "boolean"
                },
                "supportsParallelTools": {
                  "type": "boolean"
                }
              }
            },
            "pricing": {
              "type": "object",
              "required": ["currency", "perMillionTokens"],
              "properties": {
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "perMillionTokens": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-zA-Z0-9._/-]+$": {
                      "type": "object",
                      "required": ["input", "output"],
                      "properties": {
                        "input": {
                          "type": "number",
                          "minimum": 0
                        },
                        "output": {
                          "type": "number",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            },
            "endpoints": {
              "type": "object",
              "properties": {
                "chat": {
                  "type": "string",
                  "minLength": 1
                },
                "embedding": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "minProperties": 1
            },
            "additionalEnvVars": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "capabilityDefinitions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-zA-Z]*$": {
          "type": "object",
          "required": ["name", "description"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

  "capabilityDefinitions": {
    "vision": {
      "name": "Vision",
      "description": "Can process and analyze images"
    },
    "toolCalling": {
      "name": "Tool Calling",
      "description": "Can call external tools and functions"
    },
    "streaming": {
      "name": "Streaming",
      "description": "Supports real-time streaming responses"
    },
    "embedding": {
      "name": "Embeddings",
      "description": "Can generate text embeddings"
    },
    "imageGeneration": {
      "name": "Image Generation",
      "description": "Can generate images from text"
    },
    "supportsSystemMessages": {
      "name": "System Messages",
      "description": "Supports system-level instructions"
    },
    "supportsParallelTools": {
      "name": "Parallel Tools",
      "description": "Can execute multiple tools in parallel"
    }
  }

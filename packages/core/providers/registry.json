      "package": "@pk-code/openai",
      "defaultModels": {
        "chat": "gpt-4o",
        "fast": "gpt-4o-mini",
        "embedding": "text-embedding-3-large",
        "image": "dall-e-3"
      },
      "capabilities": {
        "vision": true,
        "toolCalling": true,
        "streaming": true,
        "embedding": true,
        "imageGeneration": true,
        "maxContext": 128000,
        "supportsSystemMessages": true,
        "supportsParallelTools": true
      },
      "pricing": {
        "currency": "USD",
        "perMillionTokens": {
          "gpt-4o": {
            "input": 5.0,
            "output": 15.0
          },
          "gpt-4o-mini": {
            "input": 0.15,
            "output": 0.6
          }
        }
      },
      "endpoints": {
        "chat": "https://api.openai.com/v1/chat/completions",
